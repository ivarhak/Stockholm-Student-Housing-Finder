# Runtime output — regenerated by every scrape. Committing this shipped stale
# test data to fresh clones, which the server then served as if it were current.
data/current_listings.json

# Regenerable caches. data/geocode_cache.json is deliberately NOT here: the 26
# area coordinates never change, and having them committed means a fresh clone
# (and the scheduled Actions run) skips ~26 geocoding lookups entirely.
data/grocery_cache.json
data/bike_route_cache.json

# Scrape diagnostics, written by --debug
debug_page.html

# Python / virtualenv
__pycache__/
*.pyc
venv/
.venv/

# Local working notes and editor state — not part of the project
CLAUDE.md
.claude/
.idea/
.vscode/
.DS_Store
